  "universal_guidelines": [
    "Use StyleSheet.create() for all styles to ensure performance.",
    "Do NOT use inline styles for static properties.",
    "Always wrap text in <Text> components; never raw strings.",
    "Use SafeAreaView from react-native-safe-area-context for all screen containers.",
    "Use ScrollView or FlatList for scrollable content.",
    "Implement 'Pressable' with 'style={({ pressed }) => [...]}' for custom button interactions instead of TouchableOpacity for better control.",
    "Ensure all text has a defined color; React Native defaults can be unpredictable in dark mode.",
    "Use 'testID' (not data-testid) for React Native testing.",
    "Handle keyboard avoiding views on form screens.",
    "For Indian currency, use the symbol '₹' explicitly in text strings.",
    "Food portions should handle decimals (e.g., 1.5 Roti)."
  ],
  "layout_strategies": {
    "dashboard_grid": "Bento-style layout using Flexbox (flexWrap: 'wrap', width: '48%').",
    "onboarding_wizard": "step-by-step full screen views with animated transitions.",
    "food_list": "FlatList with 'ItemSeparatorComponent' for performance."
  },
  "instructions_to_main_agent": [
    "Install 'react-native-gifted-charts' and 'expo-linear-gradient' immediately.",
    "Load 'Oswald' and 'Inter' fonts in the root layout (_layout.tsx) before rendering the app.",
    "Create a 'theme.js' or 'constants/Colors.ts' file exporting the colors defined in this JSON.",
    "Use the image URLs provided in 'assets.images' for placeholders.",
    "Ensure the default theme is DARK. The toggle should switch to a light theme (inverse of base colors)."
  ]
}